# =============================================================================
#  MarketMishmash — Configuration BACKEND (FastAPI)
# =============================================================================
#  Copiez ce fichier en « .env » (dans le dossier backend/) puis renseignez la clé :
#      cd backend
#      cp .env.example .env          # Linux / Mac
#      copy .env.example .env        # Windows (PowerShell)
#
#  ⚠️ Le fichier « backend/.env » est ignoré par Git : votre clé ne sera jamais committée.
# -----------------------------------------------------------------------------

# --- Alpha Vantage — NEWS + SENTIMENT ---------------------------------------
# Utilisée par les endpoints /api/analysis/news_av/{ticker} et /api/news/global.
#
# OPTIONNELLE : sans clé (ou quota épuisé), le backend bascule automatiquement
# sur Finviz + VADER pour les news.
#
# Deux méthodes de configuration (au choix) :
#   1. Via l'interface : bouton « 🔑 Configurer les APIs » → Alpha Vantage.
#      La clé est envoyée au backend via le header HTTP « X-Alpha-Vantage-Key »
#      et reste PRIORITAIRE sur ce fichier .env.
#   2. Via ce fichier .env (repli).
#
# Clé gratuite (25 requêtes/jour) : https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=votre_cle_alpha_vantage_ici

# =============================================================================
#  Remarque : c'est actuellement la SEULE clé lue côté backend.
#  Les autres sources backend (Yahoo Finance pour l'OHLCV, Finviz pour les
#  fondamentaux et les news de repli) ne nécessitent aucune clé.
# =============================================================================
